---
import Layout from '~/layouts/PageLayout.astro';
import CustomHeroText from '~/components/widgets/CustomHeroText.astro';
import Features from '~/components/widgets/Features.astro';
import Steps from '~/components/widgets/Steps.astro';
import Stats from '~/components/widgets/Stats.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import Content from '~/components/widgets/Content.astro';
import ContactModal from '~/components/widgets/ContactModal.astro';
import CustomHeader from '~/components/widgets/CustomHeader.astro';

const metadata = {
  title: 'Complete Billing Solutions | 96-98% Collection Rate for Mental Health Providers',
  description:
    'Specialized medical billing services for mental health providers in Worcester. Increase your collection rate to 96-98% with our comprehensive billing management.',
  ignoreTitleTemplate: true,
};

// FAQ items for content section
const faqs = [
  {
    title: 'How does CBS achieve a 96-98% collection rate?',
    description:
      'Our exceptionally high collection rate comes from our weekly on-site visits, continuous insurance eligibility verification, electronic submission, and persistent follow-up on denied claims. This comprehensive approach allows us to address issues promptly and maximize revenue recovery.',
  },
  {
    title: 'What makes CBS different from other medical billing services?',
    description:
      'Unlike general billing services, we specialize exclusively in mental health billing requirements. Our focused expertise, weekly client visits, and 20+ years of industry experience allow us to navigate the specific challenges of mental health billing more effectively.',
  },
  {
    title: 'What is your fee structure?',
    description:
      'Our fee structure ranges from 5-8% of collections, depending on the specific services required. This is typically lower than the industry average of 7-12%, and our high collection rate ensures you receive more revenue even after our fees.',
  },
];

// Calculating your savings section data
const avgCollectionRate = 75; // Industry average
const cbsCollectionRate = 97; // CBS average
---

<Layout metadata={metadata} showHeader={false}>
  <!-- Use the reusable CustomHeader component with transition:replace -->
  <CustomHeader transition:replace />

  <!-- Hero Section Implementation -->
  <div class="relative overflow-hidden">
    <!-- Background Pattern -->
    <div
      class="absolute inset-0 bg-gradient-to-br from-primary-900/5 to-primary-500/10 dark:from-primary-900/20 dark:to-primary-500/30 z-0"
    >
    </div>
    <div
      class="absolute inset-0 opacity-30 dark:opacity-20"
      style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%230057B8\' fill-opacity=\'0.1\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"
    >
    </div>

    <div class="relative z-10">
      <CustomHeroText
        title="<span class='text-6xl md:text-7xl font-extrabold text-primary'>96-98%</span> Collection Rate for Mental Health Providers"
        subtitle="Complete Billing Solutions: Specialized Medical Billing Services Since 2000."
        tagline="Over 25 Years of Dedicated Service"
        callToAction={{
          text: 'Schedule a Free Consultation',
          type: 'button',
          icon: 'tabler:calendar-time',
          class:
            'js-open-contact-modal bg-accent text-primary font-bold text-base px-6 py-3 rounded-md shadow-md hover:bg-yellow-500 hover:shadow-lg dark:bg-secondary dark:text-white dark:hover:bg-sky-500 transition-all duration-200 ease-in-out transform hover:-translate-y-0.5 hover:ring-2 hover:ring-accent hover:ring-offset-2 hover:ring-offset-bg-page focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-page',
        }}
        callToAction2={{ text: 'Learn About Our Services', href: '#features', icon: 'tabler:info-circle' }}
      />
    </div>
  </div>

  <!-- Calculate Your Savings Widget -->
  <div class="cbs-section bg-white dark:bg-slate-900 border-t border-b border-gray-100 dark:border-gray-800">
    <div class="container mx-auto">
      <div
        class="max-w-3xl mx-auto bg-gradient-to-r from-primary-50 to-blue-50 dark:from-primary-900/30 dark:to-blue-900/30 rounded-xl p-8 shadow-md"
      >
        <h3 class="text-2xl font-bold text-center text-primary dark:text-primary-400 mb-6">
          Calculate Your Revenue Potential
        </h3>
        <p class="text-center mb-8">See the financial impact a 96-98% collection rate could have on your practice:</p>
        <div class="text-center mb-8">
          <span class="inline-block bg-primary text-white px-4 py-2 rounded-full font-medium">CBS Difference</span>
        </div>
        <div class="grid md:grid-cols-3 gap-6 text-center">
          <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
            <h4 class="font-semibold mb-2">Industry Average</h4>
            <p class="text-4xl font-bold text-gray-500">{avgCollectionRate}%</p>
            <p class="mt-2 text-gray-600 dark:text-gray-400">Collection Rate</p>
          </div>

          <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm relative">
            <h4 class="font-semibold mb-2">With CBS</h4>
            <p class="text-4xl font-bold text-primary">{cbsCollectionRate}%</p>
            <p class="mt-2 text-primary-600 dark:text-primary-400">Collection Rate</p>
          </div>

          <div class="bg-white dark:bg-slate-800 p-6 rounded-lg shadow-sm">
            <h4 class="font-semibold mb-2">Additional Revenue</h4>
            <p class="text-4xl font-bold text-green-600">+22%</p>
            <p class="mt-2 text-green-700 dark:text-green-500">Average Increase</p>
          </div>
        </div>

        <div class="mt-8 text-center">
          <p class="italic text-gray-700 dark:text-gray-300">
            For a practice billing $500,000 annually, this could mean an additional <span
              class="font-bold text-green-600">$110,000</span
            > in revenue!
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Features Section Implementation -->
  <Features
    id="features"
    tagline="Our Core Strengths"
    title="Why Mental Health Providers Choose CBS"
    subtitle="We deliver comprehensive, specialized billing services with a personal touch, ensuring you maximize revenue and minimize administrative burdens."
    items={[
      {
        title: 'Mental Health Billing Specialists',
        description:
          'Deep expertise in mental health codes, insurance nuances, and compliance, ensuring accurate and optimized claim submissions.',
        icon: 'tabler:brain',
      },
      {
        title: 'Industry-Leading 96-98% Collection Rate',
        description:
          'Our persistent follow-up and meticulous processes consistently achieve collection rates far exceeding the industry average.',
        icon: 'tabler:chart-line',
      },
      {
        title: 'Weekly On-Site Client Visits',
        description:
          'Regular, face-to-face meetings to proactively address concerns, review performance, and maintain strong partnerships.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Comprehensive End-to-End Management',
        description:
          'From initial credentialing and fee schedule negotiation to claim submission, payment posting, and detailed reporting.',
        icon: 'tabler:arrows-shuffle',
      },
    ]}
    classes={{
      container: 'cbs-section bg-gray-50 dark:bg-slate-900/20',
      title: 'text-cbs-headline text-center mb-4 font-bold',
      subtitle: 'text-cbs-subtitle text-center max-w-3xl mx-auto mb-12 md:mb-16',
      items: 'grid md:grid-cols-2 gap-8 xl:gap-10',
      item: 'p-6 bg-white dark:bg-slate-800 rounded-lg shadow-md hover:shadow-lg transition-all duration-300 text-center transform hover:-translate-y-1',
      icon: 'mx-auto mb-4 flex items-center justify-center w-16 h-16 rounded-full bg-primary text-white text-3xl',
      itemTitle: 'text-xl font-bold text-primary dark:text-primary-400 mb-2',
      itemDescription: 'text-gray-700 dark:text-slate-300 text-base leading-relaxed',
    }}
  />

  <!-- Section Divider -->
  <div class="container mx-auto px-4">
    <div class="py-4 flex items-center">
      <div class="flex-grow h-px bg-gray-200 dark:bg-gray-700"></div>
      <div class="flex-shrink mx-4">
        <svg
          class="w-6 h-6 text-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
        </svg>
      </div>
      <div class="flex-grow h-px bg-gray-200 dark:bg-gray-700"></div>
    </div>
  </div>

  <!-- Steps Section -->
  <Steps
    id="process"
    tagline="Our Process"
    title="How We Maximize Your Collections"
    subtitle="Our meticulous approach ensures industry-leading collection rates through these key steps:"
    items={[
      {
        title: 'Weekly Client Visits',
        description: 'We maintain regular communication to address issues promptly',
        icon: 'tabler:calendar-stats',
      },
      {
        title: 'Insurance Verification',
        description: 'Continuous eligibility checks before service delivery',
        icon: 'tabler:clipboard-check',
      },
      {
        title: 'Electronic Submission',
        description: 'Direct submission to insurance carriers',
        icon: 'tabler:send',
      },
      {
        title: 'Authorization Management',
        description: 'Tracking requirements and expiration dates',
        icon: 'tabler:clock',
      },
      {
        title: 'Claim Follow-up',
        description: 'Persistent pursuit of denied or delayed claims',
        icon: 'tabler:refresh',
      },
    ]}
    classes={{
      container: 'cbs-section',
      title: 'text-cbs-headline text-center mb-4 font-bold',
      subtitle: 'text-cbs-subtitle text-center max-w-3xl mx-auto mb-12',
      items: 'relative flex flex-col gap-6 md:gap-8',
      item: 'flex',
      icon: 'flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white text-xl mr-4 mt-1',
      itemTitle: 'text-xl font-semibold text-primary dark:text-primary-400',
      itemDescription: 'text-gray-700 dark:text-slate-300 leading-relaxed',
    }}
  />

  <!-- Section Divider -->
  <div class="container mx-auto px-4">
    <div class="py-4 flex items-center">
      <div class="flex-grow h-px bg-gray-200 dark:bg-gray-700"></div>
      <div class="flex-shrink mx-4">
        <svg
          class="w-6 h-6 text-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
        </svg>
      </div>
      <div class="flex-grow h-px bg-gray-200 dark:bg-gray-700"></div>
    </div>
  </div>

  <!-- Why Us Section -->
  <Stats
    id="whyus"
    tagline="Why Choose CBS"
    title="Proven Track Record of Excellence"
    subtitle="Our commitment to specialized, high-touch service delivers measurable results:"
    stats={[
      { title: 'Years in Business', amount: '25+' },
      { title: 'Collection Rate', amount: '96-98%' },
      { title: 'Fee Structure', amount: '5-8%' },
      { title: 'HIPAA Compliance', amount: '100%' },
      { title: 'Client Visits', amount: 'Weekly' },
    ]}
    classes={{
      container: 'cbs-section bg-gray-50 dark:bg-slate-900/20',
      title: 'text-cbs-headline text-center mb-4 font-bold',
      subtitle: 'text-cbs-subtitle text-center max-w-3xl mx-auto mb-12',
      stats: 'grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5',
      stat: 'bg-white dark:bg-slate-800 rounded-lg shadow-md p-8 text-center transform transition-all duration-300 hover:shadow-lg hover:-translate-y-1',
      amount: 'font-bold text-4xl lg:text-5xl text-primary dark:text-primary-400',
      statTitle: 'text-gray-700 dark:text-slate-300 mt-2',
    }}
  />

  <!-- Section Divider -->
  <div class="container mx-auto px-4">
    <div class="py-4 flex items-center">
      <div class="flex-grow h-px bg-gray-200 dark:bg-gray-700"></div>
      <div class="flex-shrink mx-4">
        <svg
          class="w-6 h-6 text-primary"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path>
        </svg>
      </div>
      <div class="flex-grow h-px bg-gray-200 dark:bg-gray-700"></div>
    </div>
  </div>

  <!-- Testimonials Section with Improved Design -->
  <div class="cbs-section relative overflow-hidden">
    <!-- Background elements -->
    <div
      class="absolute top-10 left-10 text-9xl text-primary/10 dark:text-primary/5"
      style="font-family: serif, Georgia;"
    >
      "
    </div>
    <div
      class="absolute bottom-10 right-10 text-9xl text-primary/10 dark:text-primary/5"
      style="font-family: serif, Georgia;"
    >
      "
    </div>

    <Testimonials
      id="testimonials"
      tagline="Client Success Stories"
      title="What Mental Health Providers Say"
      subtitle="Hear directly from practices that have transformed their billing processes with our services:"
      testimonials={[
        {
          title: 'Dr. Sarah Johnson',
          job: 'Clinical Psychologist',
          testimonial:
            "Complete Billing Solutions increased our collection rate from 75% to 97% within just three months. Their weekly visits ensure we're always on the same page.",
        },
        {
          title: 'Dr. Michael Chen',
          job: 'Psychiatric Practice Owner',
          testimonial:
            "Their expertise in mental health billing codes has made a tremendous difference. We've recaptured revenue we didn't even know we were missing.",
        },
        {
          title: 'Worcester Therapy Associates',
          job: 'Group Practice',
          testimonial:
            'Since partnering with CBS, our administrative burden has decreased while our collections have increased. The 5% fee structure has more than paid for itself.',
        },
      ]}
      classes={{
        container: 'cbs-section relative z-10',
        title: 'text-cbs-headline text-center mb-4 font-bold',
        subtitle: 'text-cbs-subtitle text-center max-w-3xl mx-auto mb-12',
        testimonials: 'grid gap-8 md:grid-cols-3 items-stretch',
        testimonial:
          'bg-white dark:bg-slate-800 rounded-lg shadow-md p-6 flex flex-col relative transform transition-all duration-300 hover:shadow-lg hover:-translate-y-1',
      }}
    />
  </div>

  <!-- FAQ Section Using Content Instead of Accordion -->
  <Content
    id="faq"
    isReversed
    title="Frequently Asked Questions"
    tagline="Have Questions?"
    subtitle="Find answers to the most common questions about our medical billing services"
    items={faqs.map((faq) => ({
      title: faq.title,
      description: faq.description,
    }))}
    classes={{
      container: 'cbs-section bg-gray-50 dark:bg-slate-900/20',
      title: 'text-cbs-headline text-center mb-4 font-bold',
      subtitle: 'text-cbs-subtitle text-center max-w-3xl mx-auto mb-12',
      items: 'space-y-8 max-w-3xl mx-auto',
    }}
  />

  <!-- CTA Section with Fixed Contrast -->
  <div id="contact" class="cbs-section bg-primary-700 dark:bg-primary-800">
    <div class="max-w-6xl mx-auto">
      <div class="max-w-3xl mx-auto text-center p-8 rounded-lg shadow-xl bg-white dark:bg-slate-800">
        <h2 class="text-3xl font-bold mb-4 text-primary-700 dark:text-primary-400">
          Discover Your Practice's Collection Potential
        </h2>
        <p class="text-gray-700 dark:text-gray-300 mb-8 mx-auto max-w-3xl">
          Contact us for a billing assessment and discover how we can improve your collection rate
        </p>
        <div class="flex flex-col sm:flex-row sm:justify-center gap-4">
          <button
            type="button"
            id="open-contact-modal-button"
            class="js-open-contact-modal inline-flex items-center justify-center bg-accent text-primary font-bold text-base px-6 py-3 rounded-md shadow-md hover:bg-yellow-500 hover:shadow-lg dark:bg-secondary dark:text-white dark:hover:bg-sky-500 transition-all duration-200 ease-in-out transform hover:-translate-y-0.5 hover:ring-2 hover:ring-accent hover:ring-offset-2 hover:ring-offset-bg-page focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-page"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 mr-2"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
              <path d="M3 7l9 6l9 -6"></path>
            </svg>
            Contact Us
          </button>
          <button
            type="button"
            class="js-open-contact-modal inline-flex items-center justify-center border-2 border-primary text-primary font-semibold text-base px-6 py-3 rounded-md shadow-sm hover:bg-primary hover:text-white hover:shadow-md dark:border-white dark:text-white dark:hover:bg-white dark:hover:text-primary transition-all duration-200 ease-in-out transform hover:-translate-y-0.5 hover:ring-2 hover:ring-primary hover:ring-offset-2 hover:ring-offset-bg-page dark:hover:ring-white focus:outline-none focus-visible:ring-2 focus-visible:ring-primary dark:focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-bg-page"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="icon icon-tabler icon-tabler-calendar-time w-5 h-5 mr-2"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              fill="none"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
              <path d="M11.795 21h-6.795a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v4"></path>
              <path d="M18 18m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
              <path d="M15 3v4"></path>
              <path d="M7 3v4"></path>
              <path d="M3 11h16"></path>
              <path d="M18 16.496v1.504l1 1"></path>
            </svg>
            Schedule Your Free Consultation
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Contact Button -->
  <div class="fixed bottom-8 right-8 z-50">
    <button
      type="button"
      class="js-open-contact-modal flex items-center justify-center p-4 rounded-full shadow-lg transform transition-all duration-200 ease-in-out bg-primary text-white hover:bg-yellow-500 dark:hover:bg-sky-500 hover:scale-110 hover:shadow-lg hover:ring-2 hover:ring-accent hover:ring-offset-2 hover:ring-offset-bg-page focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg-page"
      aria-label="Open contact form"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
        <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"></path>
        <path d="M3 7l9 6l9 -6"></path>
      </svg>
    </button>
  </div>

  <ContactModal />
</Layout>

<style is:global>
  :root {
    --cbs-primary: #0057b8;
    --cbs-primary-light: #00a0df;
    --cbs-accent: #ffb81c;

    /* Typography colors */
    --cbs-headline: #333333;
    --cbs-subtitle: #666666;
  }

  .dark {
    --cbs-headline: #ffffff;
    --cbs-subtitle: #e0e0e0;
  }

  .cbs-section {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .cbs-section {
      padding-top: 5rem;
      padding-bottom: 5rem;
    }
  }

  /* Animation for CTA buttons */
  @keyframes pulse {
    0%,
    100% {
      transform: scale(1);
    }
    50% {
      transform: scale(1.05);
    }
  }

  .pulse-animation {
    animation: pulse 3s infinite;
  }

  /* Animation for CTA buttons */
</style>
