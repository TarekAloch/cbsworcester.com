---
import PageLayout from '~/layouts/PageLayout.astro';
// import Header from '~/components/widgets/Header.astro'; // Removed
import Hero2 from '~/components/widgets/Hero2.astro'; // Using Hero2
import Features2 from '~/components/widgets/Features2.astro'; // Using Features2
import Stats from '~/components/widgets/Stats.astro'; // Using Stats for 'Why Us'
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
// import Footer from '~/components/widgets/Footer.astro'; // Removed

const metadata = {
  title: 'Preview Page B - Alternate Flow',
  description: 'Visual preview of structure B.',
  robots: { index: false, follow: false }
};
---

<PageLayout metadata={metadata}>
  {/* Header removed - Provided by Layout */}
  {/* <Header /> */}

  <Hero2
    title="[Hero Title Placeholder - Structure B]"
    subtitle="[Hero subtitle placeholder for the alternate layout.]"
    actions={[ { text: '[Primary Action Button]', href: '#' } ]}
    image={{ src: '~/assets/images/hero-image.png', alt: '[Placeholder Image]' }}
  />
  <Features2
    title="[Services Section Title - Style B]"
    columns={3}
    items={[
      { title: '[Service 1 Title]', description: '[Brief description of service 1.]', icon: 'tabler:check' },
      { title: '[Service 2 Title]', description: '[Brief description of service 2.]', icon: 'tabler:check' },
      { title: '[Service 3 Title]', description: '[Brief description of service 3.]', icon: 'tabler:check' },
    ]}
  />
  <Stats
    title="[Why Choose Us Section Title - Stats Style]"
    columns={3}
    items={[
      { title: '98%', description: 'Collection Rate Placeholder' },
      { title: '20+', description: 'Years Experience Placeholder' },
      { title: '100s', description: 'Providers Served Placeholder' },
    ]}
  />
  <Testimonials
    title="[Testimonial Section Title]"
    testimonials={[
      { testimonial: '[Placeholder client testimonial quote B.]', name: '[Client Name B]', job: '[Client Title B]' }
    ]}
  />
  <CallToAction
    title="[Call To Action Title Placeholder B]"
    actions={[ { text: '[Contact Us Button B]', href: '#' } ]}
  />

  {/* Footer removed - Provided by Layout */}
  {/* <Footer /> */}
</PageLayout>