---
import PageLayout from '~/layouts/PageLayout.astro';
// import Header from '~/components/widgets/Header.astro'; // Removed
import Hero from '~/components/widgets/Hero.astro'; // Standard Hero
import Features from '~/components/widgets/Features.astro'; // Standard Features
import Content from '~/components/widgets/Content.astro'; // Content for 'Why Us'
import Testimonials from '~/components/widgets/Testimonials.astro'; // Placed earlier
import CallToAction from '~/components/widgets/CallToAction.astro';
// import Footer from '~/components/widgets/Footer.astro'; // Removed

const metadata = {
  title: 'Preview Page F - Focused Flow',
  description: 'Visual preview of structure F.',
  robots: { index: false, follow: false }
};
---

<PageLayout metadata={metadata}>
  {/* Header removed - Provided by Layout */}
  {/* <Header /> */}

  <Hero
    title="[Hero Title Placeholder - Structure F]"
    subtitle="[Hero subtitle placeholder text F.]"
    actions={[ { text: '[Primary Action Button F]', href: '#' } ]}
  />
  <Features
    title="[Services Section Title F]"
    columns={3}
    items={[
      { title: '[Service 1 Title F]', description: '[Brief description F.]', icon: 'tabler:check' },
      { title: '[Service 2 Title F]', description: '[Brief description F.]', icon: 'tabler:check' },
      { title: '[Service 3 Title F]', description: '[Brief description F.]', icon: 'tabler:check' },
    ]}
  />
  <Content
    title="[Why Choose Us Section Title F]"
    columns={1}
    items={[
      { title: '[Benefit 1 Title F]', icon: 'tabler:check' },
      { title: '[Benefit 2 Title F]', icon: 'tabler:check' },
      { title: '[Benefit 3 Title F]', icon: 'tabler:check' },
      { title: '[Benefit 4 Title F]', icon: 'tabler:check' },
    ]}
  />
  {/* Moved up */}
  <Testimonials
    title="[Testimonial Section Title F]"
    testimonials={[
      { testimonial: '[Placeholder client testimonial quote F.]', name: '[Client Name F]', job: '[Client Title F]' }
    ]}
  />
  <CallToAction
    title="[Call To Action Title Placeholder F]"
    actions={[ { text: '[Contact Us Button F]', href: '#' } ]}
  />

  {/* Footer removed - Provided by Layout */}
  {/* <Footer /> */}
</PageLayout>