---
import PageLayout from '~/layouts/PageLayout.astro';
// import Header from '~/components/widgets/Header.astro'; // Removed
import Hero2 from '~/components/widgets/Hero2.astro'; // Using Hero2
import Features2 from '~/components/widgets/Features2.astro'; // Using Features2
import Stats from '~/components/widgets/Stats.astro'; // Using Stats for 'Why Us'
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
// import Footer from '~/components/widgets/Footer.astro'; // Removed

const metadata = {
  title: 'Preview Page E - Split Hero + Styled Feat + Stats',
  description: 'Visual preview of structure E.',
  robots: { index: false, follow: false }
};
---

<PageLayout metadata={metadata}>
  {/* Header removed - Provided by Layout */}
  {/* <Header /> */}

  <Hero2
    title="[Hero Title Placeholder - Structure E]"
    subtitle="[Hero subtitle for split layout E.]"
    actions={[ { text: '[Primary Action Button E]', href: '#' } ]}
    image={{ src: '~/assets/images/hero-image.png', alt: '[Placeholder Image E]' }}
  />
  <Features2
    title="[Services Section Title - Style E]"
    columns={3}
    items={[
      { title: '[Service 1 Title E]', description: '[Brief description E.]', icon: 'tabler:check' },
      { title: '[Service 2 Title E]', description: '[Brief description E.]', icon: 'tabler:check' },
      { title: '[Service 3 Title E]', description: '[Brief description E.]', icon: 'tabler:check' },
    ]}
  />
  <Stats
    title="[Why Choose Us Section Title - Stats Style E]"
    stats={[
      { amount: '98%', title: 'Collection Rate Placeholder E' },
      { amount: '20+', title: 'Years Experience Placeholder E' },
      { amount: '100s', title: 'Providers Served Placeholder E' },
    ]}
  />
  <Testimonials
    title="[Testimonial Section Title E]"
    testimonials={[
      { testimonial: '[Placeholder client testimonial quote E.]', name: '[Client Name E]', job: '[Client Title E]' }
    ]}
  />
  <CallToAction
    title="[Call To Action Title Placeholder E]"
    actions={[ { text: '[Contact Us Button E]', href: '#' } ]}
  />

  {/* Footer removed - Provided by Layout */}
  {/* <Footer /> */}
</PageLayout>
