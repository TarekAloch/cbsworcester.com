---
import PageLayout from '~/layouts/PageLayout.astro';
// import Header from '~/components/widgets/Header.astro'; // Removed
import HeroText from '~/components/widgets/HeroText.astro'; // Using HeroText
import Features from '~/components/widgets/Features.astro'; // Standard Features
import Steps from '~/components/widgets/Steps.astro'; // Using Steps
import Content from '~/components/widgets/Content.astro'; // Content for 'Why Us'
import Testimonials from '~/components/widgets/Testimonials.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
// import Footer from '~/components/widgets/Footer.astro'; // Removed

const metadata = {
  title: 'Preview Page D - Text Hero + Steps',
  description: 'Visual preview of structure D.',
  robots: { index: false, follow: false }
};
---

<PageLayout metadata={metadata}>
  {/* Header removed - Provided by Layout */}
  {/* <Header /> */}

  {/* Added second CTA */}
  <HeroText
    title="[Hero Title Placeholder - Structure D]"
    subtitle="[Hero subtitle for text-only layout D.]"
    callToAction={{ text: '[Primary Action Button D]', href: '#' }}
    callToAction2={{ text: '[Secondary Action D]', href: '#' }}
  />
  <Features
    title="[Services Section Title D]"
    columns={3}
    items={[
      { title: '[Service 1 Title D]', description: '[Brief description D.]', icon: 'tabler:check' },
      { title: '[Service 2 Title D]', description: '[Brief description D.]', icon: 'tabler:check' },
      { title: '[Service 3 Title D]', description: '[Brief description D.]', icon: 'tabler:check' },
    ]}
  />
  <Steps
    title="[Our Process Section Title D]"
    items={[
        { title: 'Step 1: [Action]', description: '[Description of step 1]' },
        { title: 'Step 2: [Action]', description: '[Description of step 2]' },
        { title: 'Step 3: [Action]', description: '[Description of step 3]' },
        { title: 'Step 4: [Action]', description: '[Description of step 4]' },
    ]}
    image={{ src: '~/assets/images/default.png', alt: '[Steps Placeholder Image]' }}
  />
  <Content
    title="[Why Choose Us Section Title D]"
    columns={1}
    items={[
      { title: '[Benefit 1 Title D]', icon: 'tabler:check' },
      { title: '[Benefit 2 Title D]', icon: 'tabler:check' },
      { title: '[Benefit 3 Title D]', icon: 'tabler:check' },
      { title: '[Benefit 4 Title D]', icon: 'tabler:check' },
    ]}
  />
  <Testimonials
    title="[Testimonial Section Title D]"
    testimonials={[
      { testimonial: '[Placeholder client testimonial quote D.]', name: '[Client Name D]', job: '[Client Title D]' }
    ]}
  />
  <CallToAction
    title="[Call To Action Title Placeholder D]"
    actions={[ { text: '[Contact Us Button D]', href: '#' } ]}
  />

  {/* Footer removed - Provided by Layout */}
  {/* <Footer /> */}
</PageLayout>