---
// import '@fontsource-variable/inter';

// Add new imports
import '@fontsource/montserrat/400.css'; // Regular
import '@fontsource/montserrat/500.css'; // Medium
import '@fontsource/montserrat/600.css'; // Semi-Bold
import '@fontsource/montserrat/700.css'; // Bold
import '@fontsource/open-sans/400.css'; // Regular
import '@fontsource/open-sans/600.css'; // Semi-Bold
// Add other weights if needed by the design later

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  /* Medical Professional Blues Palette */
  :root {
    --aw-font-sans: 'Montserrat', sans-serif; /* Set default sans font */
    --aw-font-serif: serif; /* Keep a generic serif */
    --aw-font-heading: 'Montserrat', sans-serif; /* Set heading font */

    --aw-color-primary: #0057b8; /* Deep Blue - Primary */
    --aw-color-secondary: #00a0df; /* Light Blue - Secondary */
    --aw-color-accent: #ffb81c; /* Gold - Accent for CTAs */

    --aw-color-text-heading: #1f2937; /* Dark Gray Heading (adjust as needed) */
    --aw-color-text-default: #333333; /* Dark Gray - Main text */
    --aw-color-text-muted: #616161; /* Medium Gray - Secondary text */
    --aw-color-bg-page: #f5f7fa; /* Light Gray - Background */

    /* Ensure dark mode defaults exist even if not fully themed yet */
    /* Basic dark mode text/bg (can be refined later) */
    --aw-color-text-heading-dark: #e5e7eb;
    --aw-color-text-default-dark: #d1d5db;
    --aw-color-text-muted-dark: #9ca3af;
    --aw-color-bg-page-dark: #111827;
  }

  /* Basic Dark Mode Colors (Copy primary/secondary/accent for now, refine later if dark mode is implemented) */
  .dark {
    --aw-font-sans: 'Montserrat', sans-serif;
    --aw-font-serif: serif;
    --aw-font-heading: 'Montserrat', sans-serif;

    --aw-color-primary: #0057b8;
    --aw-color-secondary: #00a0df;
    --aw-color-accent: #ffb81c;

    --aw-color-text-heading: var(--aw-color-text-heading-dark);
    --aw-color-text-default: var(--aw-color-text-default-dark);
    --aw-color-text-muted: var(--aw-color-text-muted-dark);
    --aw-color-bg-page: var(--aw-color-bg-page-dark);
  }

  ::selection {
    background-color: var(--aw-color-secondary);
    color: white;
  }
  .dark ::selection {
    background-color: var(--aw-color-accent);
    color: black;
  }

  /* Custom CBS Utility Classes */
  .text-cbs-headline {
    @apply text-4xl font-bold tracking-tight text-[color:var(--aw-color-text-heading)] md:text-5xl;
    font-family: var(--aw-font-heading);
  }

  .text-cbs-subtitle {
    @apply text-xl text-[color:var(--aw-color-text-muted)] dark:text-[color:var(--aw-color-text-muted-dark)];
    font-family: var(--aw-font-sans);
  }

  .cbs-section {
    @apply px-4 py-16 sm:px-6 lg:px-8 lg:py-20; /* Consistent section padding */
  }
</style>
