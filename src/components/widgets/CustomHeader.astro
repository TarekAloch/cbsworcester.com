---
---

<div class="bg-white dark:bg-slate-800 py-2 text-sm text-center sticky top-0 z-50 shadow-md">
  <div class="container mx-auto flex justify-between items-center px-4">
    <div class="flex items-center">
      <a href="/" class="flex items-center">
        <span class="text-2xl font-bold text-gray-900 dark:text-white">🚀</span>
        <span class="ml-2 text-xl font-bold text-gray-900 dark:text-white">Complete Billing Solutions</span>
      </a>
    </div>
    <ul class="hidden md:flex justify-center space-x-6 text-primary-600 dark:text-primary-200">
      <li><a href="/" class="hover:underline">Home</a></li>
      <li><a href="/privacy" class="hover:underline">Privacy Policy</a></li>
      <li><a href="/terms" class="hover:underline">Terms</a></li>
    </ul>
    <div class="flex items-center">
      <button
        type="button"
        class="theme-toggle text-gray-500 dark:text-gray-400 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 text-sm"
        aria-label="Toggle between Dark and Light mode"
        data-aw-toggle-color-scheme
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="icon icon-tabler icon-tabler-sun sun-icon w-5 h-5"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M12 12m-4 0a4 4 0 1 0 8 0a4 4 0 1 0 -8 0"></path>
          <path d="M3 12h1m8 -9v1m8 8h1m-9 8v1m-6.4 -15.4l.7 .7m12.1 -.7l-.7 .7m0 11.4l.7 .7m-12.1 -.7l-.7 .7"></path>
        </svg>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="icon icon-tabler icon-tabler-moon moon-icon w-5 h-5"
          width="24"
          height="24"
          viewBox="0 0 24 24"
          stroke-width="2"
          stroke="currentColor"
          fill="none"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M12 3c.132 0 .263 0 .393 0a7.5 7.5 0 0 0 7.92 12.446a9 9 0 1 1 -8.313 -12.454z"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <div class="md:hidden pt-2">
    <ul class="flex flex-wrap justify-center gap-x-4 gap-y-2 text-primary-600 dark:text-primary-200 text-xs">
      <li><a href="/" class="hover:underline">Home</a></li>
      <li><a href="/privacy" class="hover:underline">Privacy Policy</a></li>
      <li><a href="/terms" class="hover:underline">Terms</a></li>
    </ul>
  </div>
</div>