---
// src/components/widgets/ContactModal.astro
// No props needed for this basic version
---

{/* Contact Modal Start - HTML Structure */}
<div
  id="contact-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-60 p-4 transition-opacity duration-500 ease-in-out"
  role="dialog"
  aria-labelledby="contact-modal-title"
  aria-modal="true"
>
  <div
    class="bg-white dark:bg-slate-800 p-6 sm:p-8 rounded-lg shadow-xl w-full max-w-lg transform transition-all duration-500 ease-in-out scale-95 opacity-0"
  >
    {/* Modal Header */}
    <div class="flex items-start justify-between mb-6">
      <h2 id="contact-modal-title" class="text-2xl font-bold text-gray-900 dark:text-white">Contact Us</h2>
      <button
        id="close-contact-modal-button"
        type="button"
        class="p-1 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-md transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 dark:focus:ring-offset-slate-800"
        aria-label="Close contact form"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    {/* Modal Body - Form */}
    <form id="contact-cbs-form" action="https://formspree.io/f/mgvkypap" method="POST">
      <div class="space-y-5">
        {/* Name Field */}
        <div>
          <label for="contact-name" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Your Name
          </label>
          <input
            type="text"
            name="name"
            id="contact-name"
            required
            class="mt-1 block w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary sm:text-sm bg-page dark:bg-slate-700 text-default dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            placeholder="John Doe"
          />
        </div>

        {/* Email Field */}
        <div>
          <label for="contact-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Your Email
          </label>
          <input
            type="email"
            name="email"
            id="contact-email"
            required
            class="mt-1 block w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary sm:text-sm bg-page dark:bg-slate-700 text-default dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            placeholder="you@example.com"
          />
        </div>

        {/* Message Field */}
        <div>
          <label for="contact-message" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">
            Message
          </label>
          <textarea
            id="contact-message"
            name="message"
            rows="4"
            required
            class="mt-1 block w-full px-3 py-2.5 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring-primary focus:border-primary sm:text-sm bg-page dark:bg-slate-700 text-default dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500"
            placeholder="How can we help you?"></textarea>
        </div>
      </div>

      {/* Modal Footer - Submit Button and Status */}
      <div class="mt-8 pt-5 border-t border-gray-200 dark:border-gray-700 flex justify-end items-center">
        <div id="form-status" class="text-sm mr-auto"></div>
        <button
          type="submit"
          class="inline-flex justify-center py-2.5 px-5 border border-transparent shadow-sm text-sm font-medium rounded-md text-white bg-primary hover:brightness-90 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary dark:focus:ring-offset-slate-800 transition-colors duration-150"
        >
          Send Message
        </button>
      </div>
    </form>
  </div>
</div>
{/* Contact Modal End */}

{/* Modal CSS - Now scoped within the component */}
<style>
  /* Ensure modal container uses flex to center its content when visible */
  /* Targeting the ID now needs :global as component styles are scoped */
  :global(#contact-modal:not(.hidden)) {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
  }

  /* Add any other styles specific ONLY to the modal structure here */
  /* Example: Input field styling overrides if needed */
  :global(.bg-page) {
    /* Example if needed */
    /* background-color: var(--aw-color-bg-page); */
  }
</style>

{/* Modal JavaScript - Now part of the component */}
<script>
  // Module-scoped variables to hold references
  let modalElement: HTMLElement | null = null;
  let modalContentElement: Element | null = null;
  let isEscListenerAttached = false;
  // Remove window flags, we'll manage listeners within page load now

  // --- Core Modal Functions ---
  function openModal() {
    if (!modalElement || !modalContentElement) {
      console.warn('Cannot open modal: Elements not found or not initialized.');
      return;
    }
    if (modalElement.classList.contains('hidden')) {
      document.body.classList.add('overflow-hidden');
      modalElement.classList.remove('hidden');
      void modalElement.offsetWidth; // Force reflow
      modalElement.classList.remove('opacity-0');
      modalContentElement.classList.remove('opacity-0', 'scale-95');
      modalContentElement.classList.add('opacity-100', 'scale-100');
      console.log('Modal opened.');
    }
  }

  function closeModal() {
    if (!modalElement || !modalContentElement) return; // Guard

    if (!modalElement.classList.contains('hidden')) {
      document.body.classList.remove('overflow-hidden');
      modalElement.classList.add('opacity-0');
      modalContentElement.classList.add('opacity-0', 'scale-95');
      modalContentElement.classList.remove('opacity-100', 'scale-100');

      const transitionDuration = 500;
      setTimeout(() => {
        if (modalElement) modalElement.classList.add('hidden');
      }, transitionDuration);
      console.log('Modal closed.');
    }
  }

  // --- Event Handlers ---
  function handleEscKey(event: KeyboardEvent) {
    if (event.key === 'Escape' && modalElement && !modalElement.classList.contains('hidden')) {
      closeModal();
    }
  }

  function closeModalOnOverlay(event: MouseEvent) {
    const target = event.target;
    if (modalElement && target instanceof Node && target === modalElement) {
      closeModal();
    }
  }

  // --- Function to Find Elements ---
  function findAndSetModalElements(): boolean {
    modalElement = document.getElementById('contact-modal') as HTMLElement | null;
    modalContentElement = modalElement ? modalElement.querySelector('div[class*="bg-white"]') : null;
    const found = !!(modalElement && modalContentElement);
    // console.log(found ? "Found modal elements." : "Did not find modal elements."); // Optional log
    return found;
  }

  // --- Delegated Open Click Handler Function ---
  // Define the handler function separately
  function handleOpenModalClick(event: MouseEvent) {
    const target = event.target;
    if (target && target instanceof Element) {
      const openButton = target.closest('.js-open-contact-modal');
      if (openButton) {
        console.log('>>> Delegated click: js-open-contact-modal button found');
        event.preventDefault();
        // Ensure elements are found *before* opening
        if (findAndSetModalElements()) {
          // Find elements NOW
          openModal();
        } else {
          console.warn('>>> Delegated click: Modal elements not found on page.');
        }
      }
    }
  }

  // --- Function to Setup ALL Listeners ---
  function setupAllModalListeners() {
    // Find elements first
    if (!findAndSetModalElements()) {
      console.log('Modal elements not found on this page load, skipping listener setup.');
      // Clean up global listener potentially left from previous page
      document.removeEventListener('keydown', handleEscKey);
      isEscListenerAttached = false;
      // We don't remove the delegated open listener here, as it might be needed if modal appears dynamically
      return; // Exit if no modal
    }
    console.log('Modal elements found, setting up listeners.');

    // --- Attach listeners specific to the modal's internal elements ---
    const closeModalButton = document.getElementById('close-contact-modal-button');
    if (closeModalButton) {
      closeModalButton.removeEventListener('click', closeModal); // Prevent duplicates
      closeModalButton.addEventListener('click', closeModal);
    }
    if (modalElement) {
      // Guard modalElement before adding listener to it
      modalElement.removeEventListener('click', closeModalOnOverlay); // Prevent duplicates
      modalElement.addEventListener('click', closeModalOnOverlay);
    }

    // --- Manage global listeners ---
    // ESC Key
    if (!isEscListenerAttached) {
      document.addEventListener('keydown', handleEscKey);
      isEscListenerAttached = true;
      console.log('ESC key listener attached.');
    } else {
      console.log('ESC key listener already attached.');
    }

    // Delegated Open Listener - Attach to document now
    // Remove first to prevent duplicates if this function runs multiple times on same page view
    document.removeEventListener('click', handleOpenModalClick);
    document.addEventListener('click', handleOpenModalClick);
    console.log('Delegated open modal listener attached to document.');

    console.log('All modal listeners set up.');
  }

  // --- Astro Page Load Handler ---
  // This runs on initial load AND after view transitions
  if (typeof document !== 'undefined') {
    document.addEventListener('astro:page-load', () => {
      console.log(`>>> astro:page-load triggered on: ${window.location.pathname}. Running listener setup...`);
      // On every page load, run the full setup
      setupAllModalListeners();
    });
  }

  // No initial call needed - astro:page-load covers the first load.

  /*
   * NOTE: 2025-05-17: Modal View Transitions Fix
   * This implementation fixes the modal functionality during Astro View Transitions by:
   * 1. Moving all listener setup into the astro:page-load event
   * 2. Using setupAllModalListeners() to manage all listeners with proper cleanup
   * 3. Using direct element references that refresh on each page load
   * 4. Properly handling event delegation for all modal interactions
   * If issues recur with the modal after view transitions, check these event bindings first.
   */
</script>
